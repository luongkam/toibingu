{
  "permissions": {
    "allow": [
      "Bash(pnpm verify*)",
      "Bash(node scripts/harness/verify.mjs*)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck*)",
      "Bash(node --test *)",
      "Bash(node scripts/harness/check-docs.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/harness/hooks.mjs session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/harness/hooks.mjs pre-edit",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/harness/hooks.mjs pre-bash",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__github__(merge_pull_request|enable_pr_auto_merge|push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/harness/hooks.mjs pre-merge || exit 2",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/harness/hooks.mjs post-edit",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/harness/hooks.mjs post-pr",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/harness/hooks.mjs stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
